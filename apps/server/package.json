{
  "name": "@devicefarmz/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "devicefarmz": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/cli.ts local",
    "dev:demo": "tsx watch src/cli.ts local --fake 8",
    "start": "node dist/cli.js local",
    "migrate": "tsx src/cli.ts migrate",
    "doctor": "tsx src/cli.ts doctor",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@devicefarmz/core": "1.0.0",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "ldapts": "^9.2.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^5.1.5",
    "openid-client": "^6.0.0",
    "prom-client": "^15.1.3",
    "ws": "^8.18.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/ldapjs": "^3.0.6",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.0",
    "ldapjs": "^3.0.7",
    "tsx": "^4.19.3"
  }
}
