# Copy to `.env` (next to package.json or in the directory you start the hub from).
# Real environment variables always take precedence over this file.

# --- Hub -------------------------------------------------------------------
DEVICEFARMZ_PORT=7100
DEVICEFARMZ_PUBLIC_IP=localhost
# DEVICEFARMZ_PUBLIC_URL=https://farm.example.com
DEVICEFARMZ_DATA=./data
# REQUIRED for anything other people can reach. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEVICEFARMZ_JWT_SECRET=change-me

# --- Devices ---------------------------------------------------------------
# ADB_PATH=/usr/bin/adb
# DEVICEFARMZ_RESET_MODE=clean        # none | clean | uninstall
# DEVICEFARMZ_AUTO_RECORD=false
# DEVICEFARMZ_FAKE_DEVICES=0          # simulated phones, handy for demos and tests

# --- Sign-in (leave empty to use the development login) --------------------
# DEVICEFARMZ_OIDC_ISSUER=https://accounts.example.com
# DEVICEFARMZ_OIDC_CLIENT_ID=
# DEVICEFARMZ_OIDC_CLIENT_SECRET=
# DEVICEFARMZ_OIDC_REDIRECT_URI=https://farm.example.com/api/auth/oidc/callback
# DEVICEFARMZ_OIDC_ADMIN_GROUP=device-farm-admins
# DEVICEFARMZ_OIDC_ALLOW_INSECURE=false   # only for a trusted internal http issuer
#
# DEVICEFARMZ_LDAP_URL=ldaps://ldap.example.com
# DEVICEFARMZ_LDAP_BIND_DN=cn=svc-farm,dc=example,dc=com
# DEVICEFARMZ_LDAP_BIND_PASSWORD=
# DEVICEFARMZ_LDAP_BASE_DN=ou=people,dc=example,dc=com
# DEVICEFARMZ_LDAP_USER_FILTER=(uid={{username}})
# DEVICEFARMZ_LDAP_ADMIN_GROUP=

# --- Assistant (optional, any OpenAI-compatible endpoint) -------------------
# DEVICEFARMZ_LLM_URL=https://api.openai.com/v1
# DEVICEFARMZ_LLM_KEY=
# DEVICEFARMZ_LLM_MODEL=gpt-4o-mini
